DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required for primary routing and primary geocoding.
ORS_API_KEY=replace-with-your-heigit-openrouteservice-key
ORS_BASE_URL=https://api.heigit.org/openrouteservice
ORS_GEOCODING_URL=https://api.heigit.org/pelias/v1/search

OSRM_BASE_URL=https://router.project-osrm.org
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1
NOMINATIM_USER_AGENT=weather-aware-truck-routing/1.0 (your-email-or-site)

ROUTING_TIMEOUT_SECONDS=30
GEOCODE_TIMEOUT_SECONDS=10
WEATHER_TIMEOUT_SECONDS=25
ROUTE_CACHE_TTL_SECONDS=300
GEOCODE_CACHE_TTL_SECONDS=3600
WEATHER_CACHE_TTL_SECONDS=900
WEATHER_BATCH_SIZE=50
WEATHER_MAX_RETRIES=2
WEATHER_RETRY_BACKOFF_SECONDS=0.5
WEATHER_MAX_RETRY_DELAY_SECONDS=10
